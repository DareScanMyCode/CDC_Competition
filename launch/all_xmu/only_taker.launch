<launch>
    <!-- UAV changi -->
    <group ns="changi">
        <!-- changi -->
        <node pkg="caric_competition_xmu" type="controller_test" name="controller_test_changi" output="screen">
            <param name="node_name" type="string" value="changi" />
            <param name="takeoff_height"  type="double" value="1"  />
            <param name="hovering_height" type="double" value="35.0" />
            <param name="uav_id" value="2"/>
        <!-- 在此添加其他参数，如果有的话 -->
        </node>
        <!-- 参数设置 -->
        <!-- changi -->
        <node pkg="caric_competition_xmu" type="subscriber_test" name="subscriber_test_changi" output="screen">
            <param name="node_name" value="changi" />
            <param name="uav_id" value="2"/>
            <param name="uav_name1" value="sentosa" />
            <param name="uav_name2" value="nanyang" />
        </node>
    </group>

    <!-- UAV sentosa -->
    <group ns="sentosa">
        <!-- sentosa -->
        <node pkg="caric_competition_xmu" type="controller_test" name="controller_test_sentosa" output="screen">
            <param name="node_name" type="string" value="sentosa" />
            <param name="takeoff_height"  type="double" value="1"  />
            <param name="hovering_height" type="double" value="35.0" />
            <param name="uav_id" value="3"/>
        <!-- 在此添加其他参数，如果有的话 -->
        </node>
        <!-- sentosa -->
        <node pkg="caric_competition_xmu" type="subscriber_test" name="subscriber_test_sentosa" output="screen">
            <param name="node_name" value="sentosa" />
            <param name="uav_id" value="3"/>
            <param name="uav_name1" value="changi" />
            <param name="uav_name2" value="nanyang" />
        </node>
    </group>

    <!-- UAV nanyang -->
    <group ns="nanyang">
        <!-- nanyang -->
        <node pkg="caric_competition_xmu" type="controller_test" name="controller_test_nanyang" output="screen">
            <param name="node_name" type="string" value="nanyang" />
            <param name="takeoff_height"  type="double" value="1"  />
            <param name="hovering_height" type="double" value="35.0" />
            <param name="uav_id" value="4"/>
        <!-- 在此添加其他参数，如果有的话 -->
        </node>

        <node pkg="caric_competition_xmu" type="subscriber_test" name="subscriber_test_nanyang" output="screen">
            <param name="node_name" value="nanyang" />
            <param name="uav_id" value="4"/>
            <param name="uav_name1" value="changi" />
            <param name="uav_name2" value="sentosa" />
        </node>
    </group>


</launch>
